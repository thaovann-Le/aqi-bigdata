# Copy this file to .env and adjust as needed. .env is gitignored.

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- docker-compose.demo.yml: thư mục dữ liệu lịch sử, tính trong container (./data -> /data) ---
# HISTORY_DIR=/data/history-full/history

# --- External API keys (used by ingestion/producer, not by docker-compose) ---
AQICN_API_TOKEN=
OPENAQ_API_KEY=
