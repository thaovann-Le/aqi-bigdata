# Secrets / local config
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Data (keep small samples in git, not full dumps)
data/
history-full/
history-hn-hcm/
*.parquet
*.csv
!**/sample_*.csv
!processing/reference/*.csv

# Đầu ra khi chạy thử pipeline (metrics, bộ dữ liệu cho ML)
processing/_runtime/

# ML artifacts (regenerate with: bash ml/run_all.sh). Figures and small result
# tables are kept in git because the report uses them.
ml/training/*.model
ml/training/*.pkl
ml/training/mlruns/
ml/outputs/models/
ml/outputs/tables/*.log
!ml/outputs/tables/*.csv

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Test coverage reports
.coverage
htmlcov/
