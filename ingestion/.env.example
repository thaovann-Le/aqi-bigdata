# Sao chép thành .env rồi điền key: cp .env.example .env
AQICN_TOKEN=dien_token_vao_day
OPENAQ_KEY=dien_key_vao_day

KAFKA_BOOTSTRAP=localhost:9092
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Chu kỳ gọi API real-time (giây)
POLL_INTERVAL_SEC=600
# Nghỉ giữa hai lần gọi Open-Meteo lịch sử (giây); tăng lên nếu bị 429
OPENMETEO_SLEEP_SEC=20
